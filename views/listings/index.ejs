<% layout("layouts/boilerplate")%>

<div class="container"></div>
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-2">Featured Listings</h1>
        <p class="text-muted">Discover amazing places to stay around the world</p>
    </div>
    
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
        <% for(let list of alllisting){ %>
        <div class="col">
            <a href="/listing/<%= list._id%>" class="listing-link text-decoration-none">
                <div class="card shadow-sm listing-card h-100">
                    <div class="overflow-hidden" style="height: 20rem;">
                        <img src="<%=list.image.url%>" 
                             class="card-img-top listing-image" 
                             alt="<%=list.title%>"
                             style="object-fit: cover; height: 100%; width: 100%;">
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="p-4">
                            <h5 class="card-title text-dark mb-1 "><%=list.title%></h5>
                            <p class="card-text text-muted mb-0">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                <%=list.location%>
                            </p>
                        </div>
                        <div class="mt-3">
                            <p class="card-text">
                                <span class="fw-bold text-primary">&#8360; <%= list.price ? list.price.toLocaleString("en-pk") : "N/A" %></span>
                                <span class="text-muted">/night</span>
                            </p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    <%}%>
</div>


    


