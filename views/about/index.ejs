
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Point - Red Edition</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* --- CSS Variables: Red, Black, White Theme --- */
        :root {
            --primary-red: #D62828;      /* Main Background Red */
            --dark-red: #9D0208;         /* Darker Red for accents */
            --accent-black: #111111;     /* Black Text/Buttons */
            --pure-white: #ffffff;       /* White */
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--primary-red);
            overflow-x: hidden;
            color: var(--pure-white);
        }

        /* --- Background Decor --- */
        .main-wrapper {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Decorative Circles (White with transparency) */
        .deco-circle {
            position: absolute;
            background-color: var(--pure-white);
            border-radius: 50%;
            z-index: 0;
            opacity: 0.15; /* Subtle blend */
        }
        .circle-1 { top: 20%; left: 45%; width: 50px; height: 50px; }
        .circle-2 { bottom: 15%; left: 5%; width: 40px; height: 40px; }
        .circle-3 { bottom: 25%; right: 35%; width: 80px; height: 80px; opacity: 0.1; }
        .circle-4 { top: 10%; right: 10%; width: 30px; height: 30px; }

        /* --- Navbar Styling --- */
        .navbar {
            padding-top: 1.5rem;
            z-index: 20;
            border-radius: 10px;
        }
     
        .navbar-brand {
            font-weight: 700;
            color: var(--pure-white) !important;
            font-size: 1.4rem;
            text-transform: uppercase;
            
        }
        .navbar-brand i {
            color: var(--accent-black); /* Black Icon */
        }

        /* Nav Links */
        .nav-link {
            color: var(--pure-white) !important;
            font-weight: 500;
           
            border-radius: 100px !important;
            padding: 0.5rem 1.2rem !important;
            transition: all 0.3s ease;
        }
        .nav-link:hover {
             background-color: var(--accent-black);
            color: var(--pure-white) !important;
            opacity: 0.8;
        }

        /* Active Pill State */
        .nav-pills .nav-link.active, .nav-pills .show>.nav-link {
            background-color: var(--accent-black);
            color: var(--pure-white) !important;
            border-radius: 50px;
        }

        /* Right Icon Box (Top Right Corner) */
        .right-icon-box {
             background-color: var(--accent-black); 
             border-bottom-left-radius: 20px;
             padding: 10px 25px;
             margin-top: -1.5rem; 
             margin-right: -12px;
        }
        .nav-icons .btn {
            color: var(--pure-white);
            border: var(--pure-white);
            font-size: 1.1rem;
        }


        /* --- Hero Section --- */
        .hero-content {
            padding-top: 4rem;
            z-index: 5;
            position: relative;
            flex-grow: 1; /* Pushes footer down */
        }

        .sub-script {
            font-family: 'Lobster', cursive;
            color: var(--pure-white);
            font-size: 2.5rem;
            margin-bottom: -15px;
            display: block;
            text-shadow: 2px 2px 0px rgba(0,0,0,0.1);
        }

        .main-title {
            font-family: 'Lobster', cursive;
            font-size: 7.5rem;
            color: var(--pure-white);
            line-height: 1;
            text-shadow: 5px 5px 0px var(--accent-black); /* Black Shadow for pop */
        }

        .discount-text {
            color: var(--accent-black); /* Black text on Red background */
            background-color: rgba(255,255,255,0.2); /* Slight highlight backdrop */
            display: inline-block;
            padding: 5px 10px;
            border-radius: 5px;
            font-weight: 800;
            letter-spacing: 1px;
            font-size: 1.1rem;
        }

        .hero-description {
            color: var(--pure-white);
            font-size: 0.95rem;
            opacity: 0.9;
            max-width: 450px;
            line-height: 1.6;
        }

        /* Buttons */
        .btn-travel-black {
            background-color: var(--accent-black);
            color: var(--pure-white);
            border-radius: 50px;
            padding: 12px 35px;
            font-weight: 600;
            border: none;
            transition: transform 0.2s;
        }
        .btn-travel-black:hover {
            transform: translateY(-3px);
            background-color: #000;
            color: #fff;
        }

        .btn-travel-white {
            background-color: var(--pure-white);
            color: var(--accent-black);
            border-radius: 50px;
            padding: 12px 35px;
            font-weight: 600;
            border: none;
            transition: transform 0.2s;
        }
        .btn-travel-white:hover {
            transform: translateY(-3px);
            background-color: #f0f0f0;
            color: #000;
        }

        /* --- Image Arch (Tombstone Shape) --- */
        .image-arch-wrapper {
            position: relative;
            z-index: 5;
            padding: 15px;
            background-color: var(--pure-white);
            border-radius: 500px 500px 0 0; /* Extreme radius for arch */
            margin-top: 1rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 420px;
        }

        .image-arch {
             border-radius: 500px 500px 0 0;
             overflow: hidden;
             height: 500px; 
             background-color: #eee;
        }

        .image-arch img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* --- Footer/Bottom Elements --- */
        .bottom-elements {
            width: 100%;
            z-index: 10;
            padding-bottom: 30px;
        }

        .number-badge {
            background-color: var(--accent-black);
            color: var(--pure-white);
            font-weight: 700;
            font-size: 1.5rem;
            padding: 15px 30px;
            border-top-right-radius: 20px;
            border-bottom-right-radius: 20px;
            display: inline-block;
        }

        .social-icons a {
            color: var(--accent-black);
            margin-right: 15px;
            font-size: 1.2rem;
            transition: color 0.3s;
        }
        .social-icons a:hover { color: var(--pure-white); }
        
        .social-text {
            color: var(--accent-black);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.9rem;
        }

        /* --- Pagination Dots (Right Side) --- */
        .right-pagination {
            position: absolute;
            right: 30px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            z-index: 10;
        }
        .pag-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-black);
            border-radius: 50%;
            opacity: 0.5;
            cursor: pointer;
        }
        .pag-dot.active {
            width: 14px;
            height: 14px;
            opacity: 1;
            border: 2px solid var(--pure-white);
            background-color: transparent;
        }
        .pag-arrow { color: var(--accent-black); margin-top: 10px; }

        /* =========================================
           RESPONSIVE MEDIA QUERIES
           ========================================= */
        
        /* Tablet & Mobile (Below 992px) */
        @media (max-width: 991px) {
            .navbar-collapse {
                background-color: var(--dark-red);
                padding: 20px;
                border-radius: 10px;
                margin-top: 10px;
                box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            }
            
            .right-icon-box {
                background: transparent;
                margin: 0;
                padding: 0;
                border-radius: 0;
            }
            
            .main-title { font-size: 5rem; }
            
            .hero-content {
                text-align: center;
                padding-top: 2rem;
            }
            
            .hero-description {
                margin: 0 auto 2rem auto; /* Center description */
            }

            .image-arch-wrapper {
                margin: 3rem auto 0 auto; /* Center image */
                height: auto;
            }
            .image-arch { height: 400px; }
            
            /* Hide the right-side pagination on tablets */
            .right-pagination { display: none; }
        }

        /* Mobile Only (Below 768px) */
        @media (max-width: 767px) {
            .main-title { font-size: 4rem; }
            .sub-script { font-size: 2rem; }
            
            .d-flex.gap-3 {
                justify-content: center; /* Center buttons */
            }

            .image-arch { height: 320px; }
            
            /* Adjust bottom elements */
            .bottom-elements { position: relative; margin-top: -50px; pointer-events: none;}
            .number-badge { font-size: 1.2rem; padding: 10px 20px; pointer-events: auto;}
            .social-icons { 
                background: rgba(255,255,255,0.9); 
                padding: 5px 15px; 
                border-radius: 20px;
                pointer-events: auto;
            }
        }
    </style>
</head>
<body>

<div class="main-wrapper">
    <div class="deco-circle circle-1"></div>
    <div class="deco-circle circle-2"></div>
    <div class="deco-circle circle-3"></div>
    <div class="deco-circle circle-4"></div>
    
    <div class="right-pagination d-none d-lg-flex">
        <div class="pag-dot active"></div>
        <div class="pag-dot"></div>
        <div class="pag-dot"></div>
        <div class="pag-dot"></div>
        <i class="fa-solid fa-chevron-down pag-arrow"></i>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid ps-lg-5 pe-0">
                <a class="navbar-brand d-flex align-items-center" href="#">
                    <div class="me-2 bg-white rounded-circle d-flex align-items-center justify-content-center" style="width:40px; height:40px; ">
                        <i class="fa-solid fa-location-dot fa-lg " style="color: red;"></i>
                    </div>
                    <div style="line-height: 1.1; ">Abdullah Mir</div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <ul class="navbar-nav nav-pills text-center">
                        <li class="nav-item mx-2"><a class="nav-link" href="#">Home</a></li>
                        <li class="nav-item mx-2"><a class="nav-link" href="#">Travels</a></li>
                        <li class="nav-item mx-2"><a class="nav-link" href="#">Offers</a></li>
                        <li class="nav-item mx-2"><a class="nav-link" href="#">Blog</a></li>
                        <li class="nav-item mx-2"><a class="nav-link" href="#">Contact</a></li>
                    </ul>
                </div>

                <div class="d-none d-lg-flex align-items-center nav-icons right-icon-box">
                    <button class="btn me-2"><i class="fa-regular fa-comment-dots"></i></button>
                    
                </div>
            </div>
        </nav>
    </header>

    <section class="hero-content">
        <div class="container h-100">
            <div class="row align-items-center h-100">
                
                <div class="col-lg-6 ps-lg-5 mb-5 mb-lg-0">
                    <span class="sub-script">it's time to</span>
                    <h1 class="main-title">Travel!</h1>
                    
                    <div class="mt-3 mb-4">
                         <span class="discount-text">BOOK AND GET 60% DISCOUNT</span>
                    </div>

                    <p class="hero-description mb-4">
                        Discover the world with our exclusive holiday packages. 
                        Luxury travel at affordable prices with full support.
                    </p>
                    
                    <div class="d-flex gap-3">
                        <a class="btn btn-travel-black shadow-lg" href="/login">Login</a>
                        <a class="btn btn-travel-white shadow-lg" href="/signup">SignUp</a>
                    </div>
                </div>
                

                <div class="col-lg-6 text-center">
                    <div class="image-arch-wrapper mx-auto">
                        <div class="image-arch">
                             <img src="https://images.unsplash.com/photo-1530789253388-582c481c54b0?q=80&w=2070&auto=format&fit=crop" alt="Traveler">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="bottom-elements">
        <div class="container-fluid px-0 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="number-badge shadow">01</div>
                
                <div class="ms-4 d-flex align-items-center social-icons">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <span class="ms-2 social-text d-none d-md-inline">Social Media</span>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>