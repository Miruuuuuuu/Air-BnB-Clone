<% if (success && success.length > 0) { %>
  <div class="flash-stack" aria-live="polite" aria-atomic="true">
    <% success.forEach(msg => { %>
      <div class="flash flash-success drop-bounce" role="alert">
        <span class="flash-icon" aria-hidden="true">
          <!-- check icon -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="flash-text"><%= msg %></span>
        <button class="flash-close" aria-label="Dismiss">&times;</button>
        <div class="flash-progress"></div>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="flash-stack" aria-live="polite" aria-atomic="true">
    <% error.forEach(msg => { %>
      <div class="flash error-success drop-bounce" role="alert">
        <span class="flash-icon" aria-hidden="true">
          <!-- check icon -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="flash-text"><%= msg %></span>
        <button class="flash-close" aria-label="Dismiss">&times;</button>
        <div class="flash-progress"></div>
      </div>
    <% }) %>
  </div>
<% } %>